<%- include("partials/header") %>

<div class="auth">
    <div class="card auth-card">
        <h1>Become a member</h1>
        <p class="muted">Create an account to request books from the library.</p>

        <% if (error) { %>
            <div class="alert alert-error"><%= error %></div>
        <% } %>

        <form action="/register" method="POST" class="form">
            <div class="field">
                <label for="name">Full name</label>
                <input type="text" id="name" name="name" value="<%= form.name || "" %>" required>
            </div>
            <div class="field">
                <label for="email">Email</label>
                <input type="email" id="email" name="email" value="<%= form.email || "" %>" required>
            </div>
            <div class="row">
                <div class="field">
                    <label for="password">Password</label>
                    <input type="password" id="password" name="password" minlength="6" required>
                </div>
                <div class="field">
                    <label for="confirmPassword">Confirm password</label>
                    <input type="password" id="confirmPassword" name="confirmPassword" minlength="6" required>
                </div>
            </div>
            <p class="hint">Use at least 6 characters.</p>
            <button type="submit" class="btn btn-primary btn-block">Create account</button>
        </form>

        <p class="small muted center">Already a member? <a href="/login">Login</a></p>
    </div>
</div>

<%- include("partials/footer") %>
